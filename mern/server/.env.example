# ── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Public base URL of this API (used to build uploaded-file links)
SERVER_URL=http://localhost:5000

# ── Database ───────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/focusprint_erp

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Mail (task assignment + daily reminders + OTP) ─────
# Leave MAIL_HOST empty to disable outgoing mail (logged to console instead)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Focus Prints ERP <no-reply@focusprints.com>"

# ── Reminders ──────────────────────────────────────────
# Daily reminder cron (Apps Script ran every day at 09:00 IST)
REMINDER_CRON=0 9 * * *
TZ_NAME=Asia/Kolkata
ENABLE_REMINDERS=true

# ── Uploads ────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15
